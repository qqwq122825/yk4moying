.class public final Lںڍڒڸ/ذ;
.super Lڨڡئٸت/ؠ;
.source "SourceFile"


# direct methods
.method public constructor <init>()V
    .locals 2

    sget-object v0, Lذ۠ۋؿ/ب;->ب:Lذ۠ۋؿ/ب;

    sget-object v1, Lڸڈڲ/ح;->ؤ:Lڸڈڲ/ح;

    invoke-direct {p0, v0, v1}, Lڨڡئٸت/ؠ;-><init>(Lڨڡئٸت/ئ;Lڸڈڲ/ح;)V

    return-void
.end method
