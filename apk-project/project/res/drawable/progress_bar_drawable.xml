<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="20.0dp" />
            <solid android:color="#2a2a2a" />
            <stroke android:width="1.0dp" android:color="#3a3a3a" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="20.0dp" />
                <solid android:color="#1a1a1a" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress">
        <clip android:gravity="left" android:clipOrientation="horizontal">
            <shape android:shape="rectangle">
                <corners android:radius="20.0dp" />
                <gradient android:startColor="#ff1744" android:endColor="#ffab00" android:angle="0.0" android:type="linear" android:centerColor="#ff6d00" />
            </shape>
        </clip>
    </item>
</layer-list>
