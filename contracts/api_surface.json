 "relay_panel": {
  "source": "SPA + 实测",
  "routes": [
   {
    "path": "/api/EaodLogin.php",
    "method": "POST",
    "desc": "登录（usrname/password/captcha；凭证错误与验证码错误分开报）",
    "evidence": "observed"
   },
   {
    "path": "/api/Captcha.php",
    "method": "GET",
    "desc": "图形验证码：{\"code\":200,\"image\":\"data:image/png;base64,..\"} + PHPSESSID",
    "evidence": "observed"
   },
   {
    "path": "/api/EaodBankInject.php?action=page&id=N",
    "method": "GET",
    "desc": "**免 token** 返回注入页 HTML（id=1 ICBC / id=2 微信）",
    "evidence": "observed"
   },
   {
    "path": "/api/EaodBankInject.php?action=<其它>",
    "method": "POST",
    "desc": "注入模板增删改查（custom_save/custom_del），需 token",
    "evidence": "observed"
   },
   {
    "path": "/api/EaodAccountManage.php",
    "method": "POST",
    "desc": "账号列表（设备转派用），需 token",
    "evidence": "observed"
   },
   {
    "path": "/api/ReassignDevice.php",
    "method": "POST",
    "desc": "设备转派 phone_id + target_usrname -> reassign_token",
    "evidence": "observed"
   },
   {
    "path": "/api/EaodVideos.php?action=list|file|list_keylog",
    "method": "POST/GET",
    "desc": "录屏分段/下载/键盘记录，需 token",
    "evidence": "observed"
   },
   {
    "path": "/api/EaodFaceVerify.php?action=list|del",
    "method": "POST",
    "desc": "人脸验证记录，需 token",
    "evidence": "observed"
   },
   {
    "path": "/api/EaodIntel.php?action=add_keyword|remove_keyword",
    "method": "POST",
    "desc": "情报关键词，需 token",
    "evidence": "observed"
   },
   {
    "path": "/api/GetPhoneById.php",
    "method": "POST",
    "desc": "按设备/手机 id 取详情（GET 405）",
    "evidence": "observed"
   },
   {
    "path": "/api/Error.php",
    "method": "GET/POST",
    "desc": "设备异常上报（缺 log data 时 400）",
    "evidence": "observed"
   },
   {
    "path": "/api/ws/",
    "method": "WS",
    "desc": "面板/设备控制通道（未授权可连，空 token 回空列表；下发有鉴权）",
    "evidence": "observed"
   }
  ]
 },
 "device_protocol": {
  "primary": {
   "register": "GET /adv.php?apk=<apkId>&device=<androidId> -> {\"resOk\":true,\"token\":<AES>}",
   "channel": "WS /io/?EIO=3&transport=websocket&apkid=&line=&cmode=&device=&ver=",
   "uplink": "42[\"enc msg\", <AES-128-ECB({\"action\",\"type\":\"enc\",\"data\"})>]（密钥 0623U25KTT3YO8P9）",
   "downlink": "42[\"new_msg\", <AES({\"action\",\"data\"})>]",
   "binary_channel": "wss://<host>:<port>/ws/binary-device?deviceId=<id>（native N_buildWsUrl 拼装）"
  },
  "relay": {
   "register": "device 侧 WS 连线 {\"itype\":\"Slr_client\",\"Deviceid\",\"pid\",\"subc\",\"b64\"}",
   "channel": "wss://<host>/api/ws/（明文 JSON 信封，无业务加密）",
   "panel_side": "itype=slr_panel；subc=checkphone/slr_panelsend/reassign（下发有鉴权）"
  }
 }
}